{
  "extends": "../../tsconfig.base.json",
  "include": ["src"],
  // Tests are typechecked by `tsconfig.test.json`, which grants them node types. The
  // published source deliberately has none: a browser SDK whose source can reach
  // `node:fs` is one that eventually does.
  "exclude": ["src/**/*.test.ts", "src/storeHarness.ts"]
}
