{
  "name": "@hermesihq/js",
  "version": "0.2.0",
  "description": "Framework-free client for Hermesi: the in-app inbox as an API client and stores, and browser push (Web Push) from the page and the service worker.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hermesihq/sdk.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/hermesihq/sdk/tree/main/packages/js#readme",
  "bugs": "https://github.com/hermesihq/sdk/issues",
  "keywords": [
    "hermesi",
    "notifications",
    "inbox",
    "sdk",
    "push",
    "web-push"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./service-worker": {
      "types": "./dist/service-worker.d.ts",
      "import": "./dist/service-worker.js",
      "require": "./dist/service-worker.cjs"
    },
    "./service-worker.global.js": "./dist/service-worker.global.js"
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsup",
    "test": "vitest run",
    "verify:package": "node ../../scripts/verify-package.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
